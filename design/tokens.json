      },
      {
        "old": "--color-surface-modal",
        "new": "--popover",
        "note": ""
      },
      {
        "old": "--color-line / --color-line-soft",
        "new": "--border",
        "note": "Merge the two levels into one"
      },
      {
        "old": "--color-line-input",
        "new": "--input",
        "note": ""
      },
      {
        "old": "--color-backdrop",
        "new": "Modal backdrop bg-black/50",
        "note": "shadcn/ui Dialog default"
      },
      {
        "old": "--color-nav-active / -ink",
