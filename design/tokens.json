{
  "description": "Source of the design tokens shared by the 8 apps. docs/design-tokens.md is generated from this file, and so is the CSS of @sirloinbh/design-tokens (#65). Names follow the shadcn/ui and Tailwind CSS 4 conventions (ADR-0007).",
  "font": {
    "sans": "\"Pretendard Variable\", Pretendard, -apple-system, BlinkMacSystemFont, system-ui, \"Apple SD Gothic Neo\", \"Noto Sans KR\", sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "pretendard": {
      "version": "1.3.9",
      "released": "2023-11-05",
      "source": "https://github.com/orioncactus/pretendard/releases/tag/v1.3.9",
      "license": "SIL Open Font License 1.1",
      "delivery": "A single PretendardVariable.woff2 from the official release zip (the full variable font, 2.0MB) is placed in the @sirloinbh/design-tokens package and served directly. No external CDN is used (works offline and as a PWA, no external dependency). The dynamic subset is distributed only as an npm package or CDN, so it is not used.",
      "fontDisplay": "swap",
      "files": {
        "Pretendard-1.3.9.zip": "04be351a74d6bf7d60c480a3087e51d185485d35a52023142af1df19eb8c428a",
        "PretendardVariable.woff2": "9599f12fd42fc0bce1cd50b47a0c022e108d7aa64dd0d1bb0ed44f3282d900b4",
        "LICENSE.txt": "b04538c9abec39a3db75108cf0af0fd9c77032fe8aa2cf38345b4d250e98e38e"
      }
    }
  },
  "fontSize": [
    {
      "name": "xs",
      "size": "0.75rem",
      "px": 12,
      "lineHeight": "1rem",
      "use": "Meta information (time, counts)"
    },
    {
      "name": "sm",
      "size": "0.875rem",
      "px": 14,
      "lineHeight": "1.25rem",
      "use": "Secondary and caption text, tables, form descriptions"
    },
    {
      "name": "base",
      "size": "1rem",
      "px": 16,
      "lineHeight": "1.6",
      "use": "Body text (line height 1.6 for Korean readability)"
    },
    {
      "name": "lg",
      "size": "1.125rem",
      "px": 18,
      "lineHeight": "1.75rem",
      "use": "Heading level 4, emphasized body text"
    },
    {
      "name": "xl",
      "size": "1.25rem",
      "px": 20,
      "lineHeight": "1.75rem",
      "use": "Heading level 3"
    },
    {
      "name": "2xl",
      "size": "1.5rem",
      "px": 24,
      "lineHeight": "2rem",
      "use": "Heading level 2, mobile heading level 1"
    },
    {
      "name": "3xl",
      "size": "1.875rem",
      "px": 30,
      "lineHeight": "2.25rem",
      "use": "Desktop heading level 1"
    }
  ],
  "fontWeight": [
    {
      "name": "normal",
      "value": 400,
      "use": "Body text"
    },
    {
      "name": "medium",
      "value": 500,
      "use": "Buttons, menus, labels"
    },
    {
      "name": "semibold",
      "value": 600,
      "use": "Heading levels 2-4, card titles"
    },
    {
      "name": "bold",
      "value": 700,
      "use": "Heading level 1, emphasized numbers"
    }
  ],
  "textStyles": [
    {
      "name": "h1",
      "element": "h1",
      "size": "2xl",
      "sizeMd": "3xl",
      "weight": "bold",
      "tracking": "-0.02em",
      "color": "foreground",
      "use": "Page title. One per page"
    },
    {
      "name": "h2",
      "element": "h2",
      "size": "xl",
      "sizeMd": "2xl",
      "weight": "semibold",
      "tracking": "-0.02em",
      "color": "foreground",
      "use": "Section title"
    },
    {
      "name": "h3",
      "element": "h3",
      "size": "lg",
      "sizeMd": "xl",
      "weight": "semibold",
      "tracking": "-0.01em",
      "color": "foreground",
      "use": "Card and subsection titles"
    },
    {
      "name": "h4",
      "element": "h4",
      "size": "base",
      "sizeMd": "lg",
      "weight": "semibold",
      "tracking": "0",
      "color": "foreground",
      "use": "Small group title"
    },
    {
      "name": "body",
      "element": "p",
      "size": "base",
      "sizeMd": "base",
      "weight": "normal",
      "tracking": "0",
      "color": "foreground",
      "use": "Body text"
    },
    {
      "name": "body-sm",
      "element": "p",
      "size": "sm",
      "sizeMd": "sm",
      "weight": "normal",
      "tracking": "0",
      "color": "foreground",
      "use": "Tables, body text in narrow areas"
    },
    {
      "name": "caption",
      "element": "p",
      "size": "sm",
      "sizeMd": "sm",
      "weight": "normal",
      "tracking": "0",
      "color": "muted-foreground",
      "use": "Secondary and caption text, input descriptions"
    },
    {
      "name": "meta",
      "element": "span",
      "size": "xs",
      "sizeMd": "xs",
      "weight": "normal",
      "tracking": "0",
      "color": "muted-foreground",
      "use": "Meta information such as dates, times, and counts"
    }
  ],
  "spacing": {
    "base": "0.25rem",
    "rule": "Use spacing only in 4px units (Tailwind spacing 1 = 4px). Common values: 1 (4px), 2 (8px), 3 (12px), 4 (16px), 6 (24px), 8 (32px), 12 (48px).",
    "layout": [
      {
        "name": "page-x",
        "mobile": "1rem",
        "md": "1.5rem",
        "lg": "2rem",
        "use": "Page side margins"
      },
      {
        "name": "section-gap",
        "mobile": "1.5rem",
        "md": "2rem",
        "lg": "2rem",
        "use": "Gap between sections"
      },
      {
        "name": "stack-gap",
        "mobile": "0.75rem",
        "md": "1rem",
        "lg": "1rem",
        "use": "Gap between cards and form items"
      },
      {
        "name": "content-max",
        "mobile": "100%",
        "md": "48rem",
        "lg": "72rem",
        "use": "Maximum body width"
      }
    ]
  },
  "radius": [
    {
      "name": "base",
      "css": "--radius",
      "value": "0.625rem",
      "px": 10,
      "use": "Base value (shadcn/ui --radius)"
    },
    {
      "name": "sm",
      "css": "--radius-sm",
      "value": "calc(var(--radius) - 4px)",
      "px": 6,
      "use": "Badges, small input elements"
    },
    {
      "name": "md",
      "css": "--radius-md",
      "value": "calc(var(--radius) - 2px)",
      "px": 8,
      "use": "Buttons, input fields"
    },
    {
      "name": "lg",
      "css": "--radius-lg",
      "value": "var(--radius)",
      "px": 10,
      "use": "Cards, menus"
    },
    {
      "name": "xl",
      "css": "--radius-xl",
      "value": "calc(var(--radius) + 4px)",
      "px": 14,
      "use": "Modals, drawers"
    }
  ],
  "shadow": [
    {
      "name": "xs",
      "use": "Input fields"
    },
    {
      "name": "sm",
      "use": "Cards"
    },
    {
      "name": "md",
      "use": "Dropdown menus, popovers"
    },
    {
      "name": "lg",
      "use": "Modals, drawers"
    }
  ],
  "border": {
    "width": "1px",
    "rule": "Borders are 1px, and only the colors border (dividers) and input (input fields) are used."
  },
  "breakpoints": [
    {
      "name": "sm",
      "minWidth": "40rem",
      "px": 640,
      "use": "Large phone in landscape"
    },
    {
      "name": "md",
      "minWidth": "48rem",
      "px": 768,
      "use": "Tablet. From this width the LNB is fixed as a sidebar; narrower than this, it opens as a drawer"
    },
    {
      "name": "lg",
      "minWidth": "64rem",
      "px": 1024,
      "use": "Small laptop"
    },
    {
      "name": "xl",
      "minWidth": "80rem",
      "px": 1280,
      "use": "Desktop"
    }
  ],
  "responsive": {
    "approach": "Mobile first. Write the base styles for a 360px width, and add wider screens with the md and lg prefixes.",
    "minWidth": "360px",
    "touchTarget": "44px",
    "touchRule": "On touch devices (pointer: coarse), tappable elements are at least 44px wide and tall. If the visible size is smaller, enlarge the tap area with padding.",
    "safeArea": "Fixed headers, bottom tabs, and drawers get inner padding of env(safe-area-inset-*) (together with viewport-fit=cover).",
    "verify": "Check changed screens at 390×844 (mobile) and 1440×900 (PC)."
  },
  "icon": [
    {
      "name": "sm",
      "px": 16,
      "use": "Inside buttons and input fields"
    },
    {
      "name": "md",
      "px": 20,
      "use": "Menus, lists"
    },
    {
      "name": "lg",
      "px": 24,
      "use": "Empty states, emphasis"
    }
  ],
  "zIndex": [
    {
      "name": "base",
      "value": 0
