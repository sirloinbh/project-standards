  "motion": {
    "fast": "150ms",
    "normal": "200ms",
    "slow": "300ms",
    "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "rule": "Use fast for hover and focus, normal for menus and toasts, and slow for modals and drawers. Turn animations off under prefers-reduced-motion."
  },
  "loading": {
    "skeleton": "shadcn/ui Skeleton (bg-accent, animate-pulse). Draw it at the same size and shape as the real content (text lines, cards, lists). Use it on a screen that loads for the first time.",
    "spinner": "lucide-react Loader2Icon + animate-spin. Sizes are icon sm, md, and lg. Use it for a saving indicator inside a button and for short waits.",
    "rule": "Do not show a loading indicator for work that finishes within 300ms. Do not use a loading indicator that covers the whole screen."
  },
