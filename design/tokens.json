  "legacy": {
    "description": "Which new token each of workout-memo's existing tokens (frontend/src/theme.css) corresponds to. When the design system is applied (#126), switch according to this table.",
    "map": [
      {
        "old": "--color-primary",
        "new": "--primary",
        "note": "Black shared by all apps. There are no per-app theme colors (ADR-0008)"
      },
      {
        "old": "--color-on-primary",
        "new": "--primary-foreground",
        "note": ""
      },
      {
        "old": "--color-accent",
        "new": "--primary (lightened) or a chart color",
        "note": "The shadcn/ui accent is a hover background, so the meaning differs"
      },
      {
        "old": "--color-focus",
        "new": "--ring",
        "note": ""
      },
      {
        "old": "--color-ink",
        "new": "--foreground",
