    {
      "name": "sticky",
      "value": 10,
      "use": "Fixed header, bottom tabs"
    },
    {
      "name": "drawer",
      "value": 40,
      "use": "LNB drawer, Sheet"
    },
    {
      "name": "modal",
      "value": 50,
      "use": "Dialog and its backdrop (shadcn/ui default)"
    },
    {
      "name": "popover",
      "value": 60,
      "use": "Dropdown menus, popovers (also open above modals)"
    },
    {
      "name": "toast",
      "value": 70,
      "use": "Sonner toast"
    }
