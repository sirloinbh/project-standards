{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Platform shared values",
  "description": "Values shared by all projects: port formula, reserved ports, root domain, shared AWS values.",
  "type": "object",
  "required": ["rootDomain", "aws", "portScheme", "reservedPorts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "rootDomain": { "type": ["string", "null"], "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "description": "Service root domain. null if undecided" },
    "aws": {
      "type": "object",
      "required": ["region", "accountAlias", "sharedPrefix"],
      "additionalProperties": false,
      "properties": {
        "region": { "type": "string", "pattern": "^[a-z]{2}-[a-z]+-\\d$" },
        "accountAlias": { "type": ["string", "null"], "minLength": 1 },
        "sharedPrefix": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$" }
      }
    },
    "portScheme": {
      "type": "object",
      "required": ["web", "api", "e2eApi", "vite", "e2eWeb", "db", "maxSlot"],
      "additionalProperties": false,
      "properties": {
        "web": { "type": "integer", "minimum": 1024, "maximum": 65000 },
        "api": { "type": "integer", "minimum": 1024, "maximum": 65000 },
        "e2eApi": { "type": "integer", "minimum": 1024, "maximum": 65000 },
        "vite": { "type": "integer", "minimum": 1024, "maximum": 65000 },
        "e2eWeb": { "type": "integer", "minimum": 1024, "maximum": 65000 },
        "db": { "type": "integer", "minimum": 1024, "maximum": 65000 },
        "maxSlot": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "reservedPorts": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1, "maximum": 65535 } }
  }
}
