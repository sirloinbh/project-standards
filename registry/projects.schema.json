{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "프로젝트 고정값 레지스트리",
  "description": "프로젝트마다 다르고 서로 겹치면 안 되는 값. 동기화가 덮어쓰지 않는다. 포트는 registry/platform.json의 portScheme 공식(기준값 + slot)을 따른다.",
  "type": "object",
  "required": ["projects"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "projects": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/project" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "port": { "type": "integer", "minimum": 1024, "maximum": 65535 },
    "dbName": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "nullableHost": {
      "description": "미정이면 null. 정해지면 값만 채운다.",
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
    },
    "project": {
      "type": "object",
      "required": ["slot", "status", "name", "title", "displayName", "domain", "summary", "repos", "public", "ports", "db", "service", "aws", "features", "skills", "allowedDifferences"],
      "additionalProperties": false,
      "properties": {
        "slot": { "type": "integer", "minimum": 1, "maximum": 99, "description": "은퇴해도 다시 배정하지 않는다" },
        "status": { "enum": ["active", "retired"] },
        "name": { "$ref": "#/$defs/slug" },
        "title": { "type": "string", "minLength": 1, "description": "문서·지침에 쓰는 한국어 이름 (예: 공부 기록)" },
        "displayName": { "type": "string", "minLength": 1, "description": "화면 헤더·탭 제목·PWA 이름에 쓰는 앱 표시 이름. 앱은 이 이름으로만 구별되므로 겹치면 안 된다(ADR-0008)" },
        "domain": { "type": "string", "minLength": 1, "description": "서비스 분야 설명 (예: 운동)" },
        "summary": { "type": "string", "minLength": 10, "description": "AGENTS.md 첫 문단에 들어가는 서비스 설명" },
        "public": { "type": "boolean", "description": "우산 리포가 public이다. public 리포는 private 중앙 리포의 재사용 워크플로를 부를 수 없어서 ci.yml에 공통 CI를 펼쳐 넣는다(#209)" },
        "repos": {
          "type": "object",
          "required": ["umbrella", "frontend", "backend", "db"],
          "additionalProperties": false,
          "properties": {
            "umbrella": { "$ref": "#/$defs/slug" },
            "frontend": { "$ref": "#/$defs/slug" },
            "backend": { "$ref": "#/$defs/slug" },
            "db": { "$ref": "#/$defs/slug" }
          }
        },
        "ports": {
          "type": "object",
          "required": ["web", "api", "e2eApi", "vite", "e2eWeb", "db"],
          "additionalProperties": false,
          "properties": {
            "web": { "$ref": "#/$defs/port" },
            "api": { "$ref": "#/$defs/port" },
            "e2eApi": { "$ref": "#/$defs/port" },
            "vite": { "$ref": "#/$defs/port" },
            "e2eWeb": { "$ref": "#/$defs/port" },
            "db": { "$ref": "#/$defs/port" }
          }
        },
        "db": {
          "type": "object",
          "required": ["name", "testName"],
          "additionalProperties": false,
          "properties": { "name": { "$ref": "#/$defs/dbName" }, "testName": { "$ref": "#/$defs/dbName" } }
        },
        "service": {
          "type": "object",
          "required": ["domain", "subdomain"],
          "additionalProperties": false,
          "properties": { "domain": { "$ref": "#/$defs/nullableHost" }, "subdomain": { "$ref": "#/$defs/nullableHost" } }
        },
        "aws": {
          "type": "object",
          "required": ["prefix"],
          "additionalProperties": false,
          "properties": { "prefix": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$", "description": "AWS 리소스 이름 접두어. 미정이면 null" } }
        },
        "features": {
          "type": "object",
          "required": ["e2e", "e2eVisual", "openapi", "contract", "ui", "vitest", "claude", "devcontainer", "lighthouse", "msw"],
          "additionalProperties": false,
          "properties": {
            "e2e": { "type": "boolean", "description": "Playwright 브라우저 테스트를 쓴다. CI e2e 작업과 playwright.config.ts 템플릿(templates/e2e)을 켠다(#33)" },
            "e2eVisual": { "type": "boolean", "description": "e2e를 digest로 고정한 Playwright 컨테이너(versions.json images.playwright)에서 E2E_VISUAL=1로 실행해 스크린샷을 비교한다. e2e와 db:migrate 실행기가 있어야 켠다(#203)" },
            "openapi": { "type": "boolean" },
            "contract": { "type": "boolean" },
            "ui": { "type": "boolean", "description": "공통 UI 컴포넌트(templates/ui)를 동기화한다. 앱에 radix-ui 등 의존성을 설치한 뒤 켠다(#123, #126)" },
            "vitest": { "type": "boolean", "description": "화면 단위 테스트 설정 frontend/vitest.config.ts(templates/vitest)를 동기화한다. vitest·jsdom·Testing Library를 설치한 뒤 켠다(#33)" },
            "devcontainer": { "type": "boolean", "description": "새 PC용 Dev Container 설정(.devcontainer/, templates/devcontainer)을 동기화한다. Node는 versions.json images.devcontainerNode, DB는 앱 compose.yaml의 db 서비스를 쓴다(#282)" },
            "lighthouse": { "type": "boolean", "description": "CI에서 빌드한 프런트(frontend/dist)를 Lighthouse CI로 재고 기준 미달을 경고만 한다. lighthouserc.json(templates/lighthouse)을 동기화하고, 앱 루트에 @lhci/cli를 설치한 뒤 켠다(#280)" },
            "msw": { "type": "boolean", "description": "화면 테스트가 백엔드 없이 OpenAPI 계약(docs/openapi.json)의 MSW 목으로 돈다. frontend/src/test/contract-api.ts(templates/msw)를 동기화한다. openapi·vitest가 켜져 있고 frontend에 msw를 설치한 뒤 켠다(#281)" },
            "claude": { "type": "boolean", "description": "백엔드가 Claude API를 쓴다. 배포 스크립트가 AWS SSM에서 ANTHROPIC_API_KEY를 읽어 넘기고, 중앙 명령 tools/app-secrets.mjs가 로컬 .env에 넣는다(ADR-0010, #265)" }
          }
        },
        "skills": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/slug" }, "description": "프로젝트 고유 스킬. 동기화에서 제외한다" },
        "allowedDifferences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason", "until"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 5 },
              "until": { "type": ["string", "null"], "format": "date" }
            }
          }
        }
      }
    }
  }
}
