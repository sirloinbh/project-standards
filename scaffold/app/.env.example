# @desc PostgreSQL database name (registry db.name) @required @used=compose
POSTGRES_DB={{project.db.name}}
# @desc PostgreSQL user name @required @used=compose
POSTGRES_USER={{project.db.name}}
# @desc PostgreSQL password. Change it for local use @required @secret @used=compose,backend
POSTGRES_PASSWORD=
# @desc Database URL the API connects to. The port is the registry db port @required @secret @used=backend
DATABASE_URL=postgres://{{project.db.name}}:<password>@localhost:{{project.ports.db}}/{{project.db.name}}
# @desc API port (registry api port) @required @used=backend,compose
PORT={{project.ports.api}}
# @desc GitHub Packages read token (read:packages). Needed only to install shared packages @secret @used=npm
NODE_AUTH_TOKEN=
# --- project ---
