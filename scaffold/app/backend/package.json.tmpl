{
  "name": "@{{project.db.name}}/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "db:migrate": "tsx --env-file-if-exists=../.env src/migrate.ts"
  },
  "dependencies": {
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "{{versions.node}}",
    "npm": "{{versions.npm}}"
  },
  "packageManager": "npm@{{versions.npm}}"
}
