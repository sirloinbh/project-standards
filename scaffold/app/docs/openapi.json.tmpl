{
  "openapi": "3.1.0",
  "info": {
    "title": "{{project.title}} API",
    "version": "1.0.0",
    "description": "날짜는 YYYY-MM-DD(Asia/Seoul). 오류 응답은 모두 { error: 한국어 메시지 }입니다."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "서버와 DB 연결 상태 확인",
        "responses": {
          "200": {
            "description": "성공"
          },
          "500": {
            "description": "서버 오류",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "한국어 오류 메시지"
          }
        },
        "required": [
          "error"
        ]
      }
    }
  }
}
