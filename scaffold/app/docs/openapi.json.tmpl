{
  "openapi": "3.1.0",
  "info": {
    "title": "{{project.title}} API",
    "version": "1.0.0",
    "description": "Dates are YYYY-MM-DD (Asia/Seoul). Every error answer is { error: message }."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Check the server and database connection",
        "security": [],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "Show the signed-in user",
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Sign-in required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "A short message for the user"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "sirloinbh.session_token",
        "description": "The shared sign-in session cookie (ADR-0015)."
      }
    }
  }
}
