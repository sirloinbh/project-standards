{
  "name": "{{project.name}}",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "build": "npm run build -w frontend && npm run build -w backend",
    "test": "npm run test -w backend && npm run test -w frontend",
    "test:e2e": "playwright test",
    "db:migrate": "npm run db:migrate -w backend --",
    "contract:sync": "node scripts/contract.mjs sync",
    "contract:check": "node scripts/contract.mjs",
    "openapi": "npm run openapi -w backend",
    "skills:sync": "node scripts/claude-skills.mjs sync",
    "skills:check": "node scripts/claude-skills.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces && tsc -p e2e/tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run contract:check && npm run skills:check && npm run typecheck && npm test && npm run build",
    "standards:check": "node .standards/check.mjs",
    "lockfiles:sync": "node .standards/lockfiles.mjs --write"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@sirloinbh/eslint-config": "{{packages.eslintConfig}}",
    "@sirloinbh/prettier-config": "{{packages.prettierConfig}}",
    "@sirloinbh/tsconfig": "{{packages.tsconfig}}",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "engines": {
    "node": "{{versions.node}}",
    "npm": "{{versions.npm}}"
  },
  "packageManager": "npm@{{versions.npm}}"
}
