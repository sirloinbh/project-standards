{
  "$schema": "./sync.config.schema.json",
  "profiles": {
    "app": {
      "templates": ["common", "app"],
      "packages": ["@sirloinbh/eslint-config", "@sirloinbh/prettier-config", "@sirloinbh/tsconfig", "@sirloinbh/design-tokens", "@sirloinbh/auth-client"],
      "ci": "reusable-app-ci.yml",
      "featureTemplates": { "ui": "ui", "e2e": "e2e", "vitest": "vitest", "devcontainer": "devcontainer", "lighthouse": "lighthouse", "msw": "msw", "jobs": "jobs" },
      "neverTouch": []
    },
    "infra": {
      "templates": ["common", "infra"],
      "packages": [],
      "ci": "reusable-infra-ci.yml",
      "neverTouch": ["**/*.tf", "**/*.tfvars", "**/*.tfvars.*", "**/*.sh", ".terraform.lock.hcl"]
    },
    "service": {
      "templates": ["common", "service"],
      "packages": [],
      "ci": "reusable-service-ci.yml",
      "neverTouch": ["backend/**", "deploy/**", "compose.yaml", "README.md", ".env.example", "AGENTS.project.md"]
    }
  },
  "targets": [
    { "repo": "sirloinbh/workout-memo", "profile": "app", "project": "workout-memo" },
    { "repo": "sirloinbh/study-log", "profile": "app", "project": "study-log" },
    { "repo": "sirloinbh/health-log", "profile": "app", "project": "health-log" },
    { "repo": "sirloinbh/life-journal", "profile": "app", "project": "life-journal" },
    { "repo": "sirloinbh/money-ledger", "profile": "app", "project": "money-ledger" },
    { "repo": "sirloinbh/cert-manager", "profile": "app", "project": "cert-manager" },
    { "repo": "sirloinbh/plan-routine", "profile": "app", "project": "plan-routine" },
    { "repo": "sirloinbh/dev-career-portfolio", "profile": "app", "project": "dev-career-portfolio" },
    { "repo": "sirloinbh/shared-aws-infrastructure", "profile": "infra", "project": null },
    { "repo": "sirloinbh/shared-auth", "profile": "service", "project": null },
    { "repo": "sirloinbh/shared-ai", "profile": "service", "project": null }
  ]
}
