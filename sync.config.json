{
  "$schema": "./sync.config.schema.json",
  "profiles": {
    "app": {
      "templates": ["common", "deploy", "app"],
      "packages": ["@sirloinbh/eslint-config", "@sirloinbh/prettier-config", "@sirloinbh/tsconfig", "@sirloinbh/design-tokens", "@sirloinbh/auth-client"],
      "ci": "reusable-app-ci.yml",
      "featureTemplates": { "ui": "ui", "e2e": "e2e", "vitest": "vitest", "devcontainer": "devcontainer", "lighthouse": "lighthouse", "msw": "msw", "query": "query", "jobs": "jobs" },
      "neverTouch": []
    },
    "infra": {
      "templates": ["common", "infra"],
      "packages": [],
      "ci": "reusable-infra-ci.yml",
      "neverTouch": ["**/*.tf", "**/*.tfvars", "**/*.tfvars.*", "**/*.sh", ".terraform.lock.hcl"]
    },
    "service": {
      "templates": ["common", "deploy", "backend", "service"],
      "packages": [],
      "ci": "reusable-service-ci.yml",
      "neverTouchExcept": ["backend/src/apps.generated.ts", "backend/test/standard/*.ts", "backend/Dockerfile", "backend/.npmrc", "backend/.dockerignore", "backend/package.json"],
      "neverTouch": ["backend/**", "compose.yaml", "README.md", ".env.example", "AGENTS.project.md"]
    },
    "design-system": {
      "templates": ["common"],
      "packages": ["@sirloinbh/eslint-config", "@sirloinbh/prettier-config", "@sirloinbh/tsconfig"],
      "neverTouch": []
    },
    "utility": {
      "templates": ["common"],
      "packages": [],
      "neverTouch": []
    }
  },
  "targets": [
    { "repo": "sirloinbh/workout-memo", "wave": 1, "profile": "app", "project": "workout-memo" },
    { "repo": "sirloinbh/study-log", "wave": 2, "profile": "app", "project": "study-log" },
    { "repo": "sirloinbh/health-log", "wave": 2, "profile": "app", "project": "health-log" },
    { "repo": "sirloinbh/life-journal", "wave": 2, "profile": "app", "project": "life-journal" },
    { "repo": "sirloinbh/money-ledger", "wave": 2, "profile": "app", "project": "money-ledger" },
    { "repo": "sirloinbh/cert-manager", "wave": 2, "profile": "app", "project": "cert-manager" },
    { "repo": "sirloinbh/plan-routine", "wave": 2, "profile": "app", "project": "plan-routine" },
    { "repo": "sirloinbh/dev-career-portfolio", "wave": 2, "profile": "app", "project": "dev-career-portfolio" },
    { "repo": "sirloinbh/design-system", "wave": 1, "profile": "design-system", "project": null },
    { "repo": "sirloinbh/shared-aws-infrastructure", "profile": "infra", "project": null, "autoMergeSync": true, "generatedFiles": { "apps.json": "apps-json" } },
    { "repo": "sirloinbh/shared-auth", "profile": "service", "project": null, "autoMergeSync": true },
    { "repo": "sirloinbh/shared-ai", "profile": "service", "project": null, "generatedFiles": { "backend/src/apps.generated.ts": "apps-ts" } },
    { "repo": "sirloinbh/develop-skill", "wave": 2, "profile": "utility", "project": null, "autoMergeSync": true },
    { "repo": "sirloinbh/file-control", "wave": 1, "profile": "utility", "project": null, "autoMergeSync": true }
  ]
}
