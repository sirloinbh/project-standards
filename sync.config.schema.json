{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "동기화 대상과 프로필",
  "description": "maxRollout 이하인 target에만 동기화 PR을 연다. 0이면 아무 PR도 열지 않는다.",
  "type": "object",
  "required": ["maxRollout", "profiles", "targets"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "maxRollout": { "type": "integer", "minimum": 0 },
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["templates", "packages", "ci", "neverTouch"],
        "additionalProperties": false,
        "properties": {
          "templates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
          "packages": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^@sirloinbh/[a-z][a-z0-9-]*$" } },
          "ci": { "type": "string", "pattern": "^[a-z0-9-]+\\.yml$" },
          "neverTouch": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "동기화가 절대 바꾸지 않는 경로 패턴" },
          "featureTemplates": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }, "description": "레지스트리 features.<이름>이 true인 프로젝트에만 더하는 템플릿 폴더" }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repo", "profile", "project", "rollout"],
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string", "pattern": "^sirloinbh/[a-z][a-z0-9-]*$" },
          "profile": { "type": "string" },
          "project": { "type": ["string", "null"], "description": "app 프로필은 registry 프로젝트 이름, infra 프로필은 null" },
          "rollout": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
