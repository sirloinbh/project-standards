# Calls the central shared CI (reusable-app-ci) pinned to the central commit that was synced. Values come from the central registry and versions.json.
name: ci

# One run per commit: a pull request is tested through pull_request only; push runs on main (#699).
on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read
  # write is the most the image-push job of the reusable workflow may use; every other job gets read (ADR-0023, #754).
  packages: write

jobs:
  ci:
    uses: sirloinbh/project-standards/.github/workflows/reusable-app-ci.yml@{{central.workflowSha}}
    with:
      node-version: '{{versions.node}}'
      npm-version: '{{versions.npm}}'
      postgres-image: '{{versions.images.postgres}}'
      db-name: '{{project.db.testName}}'
      e2e: {{project.features.e2e}}
      e2e-visual: {{project.features.e2eVisual}}
      playwright-image: '{{versions.images.playwright}}'
      knip-strict: {{project.features.knipStrict}}
      push-images: {{project.deploy.push}}
      image-prefix: 'ghcr.io/sirloinbh/{{project.db.name}}'
