#!/bin/bash
# Installs and starts the nightly dump, weekly restore check and 5-minute health signal timers
# (#262, #284). Run once as root on the server; adding HEALTHCHECK_URL_* to .env later needs no rerun:
#   sudo bash /opt/{{project.name}}/deploy/install-backup.sh
set -euo pipefail
dir=$(cd "$(dirname "$0")" && pwd)
db={{project.db.name}}
install -d -o ubuntu -g ubuntu -m 700 "/var/backups/$db"
for unit in backup restore-check health; do
  install -m 644 "$dir/$unit.service" "/etc/systemd/system/$db-$unit.service"
  install -m 644 "$dir/$unit.timer" "/etc/systemd/system/$db-$unit.timer"
done
# The first server set up a cron dump for workout-memo (shared-aws-infrastructure user-data).
# The timer replaces it, so the database is not dumped twice a night.
if [ -f "/etc/cron.d/$db-backup" ]; then
  rm "/etc/cron.d/$db-backup"
  echo "removed /etc/cron.d/$db-backup (replaced by $db-backup.timer)"
fi
systemctl daemon-reload
systemctl enable --now "$db-backup.timer" "$db-restore-check.timer" "$db-health.timer"
systemctl list-timers "$db-backup.timer" "$db-restore-check.timer" "$db-health.timer" --no-pager
