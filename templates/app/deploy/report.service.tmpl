[Unit]
Description={{project.title}} daily server report for healthchecks.io
After=docker.service

[Service]
Type=oneshot
User=ubuntu
Group=docker
WorkingDirectory=/opt/{{project.name}}
# Copied first: a deploy may check out a new commit while this script runs.
ExecStart=/bin/bash -c 'cp /opt/{{project.name}}/deploy/report.sh /tmp/{{project.db.name}}-report.sh && exec /bin/bash /tmp/{{project.db.name}}-report.sh'
TimeoutStartSec=5min
