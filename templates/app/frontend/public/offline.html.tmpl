<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
{{theme.offlineMeta}}
    <title>{{project.displayName}} · Offline</title>
    <style>
{{theme.offlineStyle}}
      body { margin: 0; min-height: 100dvh; display: grid; place-items: center; padding: 1rem; background: var(--bg); color: var(--fg); font-family: system-ui, sans-serif; text-align: center; }
      p { color: var(--muted); }
      button { min-height: 44px; padding: 0 1.25rem; border: 1px solid currentColor; border-radius: 0.5rem; background: none; color: inherit; font: inherit; }
    </style>
  </head>
  <body>
    <main>
      <h1>You are offline</h1>
      <p>{{project.displayName}} will open again once you are back online.</p>
      <button type="button" onclick="location.reload()">Try again</button>
    </main>
  </body>
</html>
