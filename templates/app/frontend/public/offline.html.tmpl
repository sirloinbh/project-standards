<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
{{theme.offlineMeta}}
    <title>{{project.displayName}} · 오프라인</title>
    <style>
{{theme.offlineStyle}}
      body { margin: 0; min-height: 100dvh; display: grid; place-items: center; padding: 1rem; background: var(--bg); color: var(--fg); font-family: system-ui, sans-serif; text-align: center; }
      p { color: var(--muted); }
      button { min-height: 44px; padding: 0 1.25rem; border: 1px solid currentColor; border-radius: 0.5rem; background: none; color: inherit; font: inherit; }
    </style>
  </head>
  <body>
    <main>
      <h1>인터넷에 연결되어 있지 않습니다</h1>
      <p>{{project.displayName}}은(는) 연결되면 다시 열 수 있습니다.</p>
      <button type="button" onclick="location.reload()">다시 시도</button>
    </main>
  </body>
</html>
