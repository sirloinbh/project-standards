{
  "description": "Files under templates/<folder> are rendered to the same path in the target repo. A trailing .tmpl is dropped (so Git, npm, and editors do not read the file as real config in the central repo). Files not listed here are fully managed (full).",
  "section": [".gitignore", ".prettierignore"],
  "vendor": {
    "why": "Check scripts and their libraries are copied as they are so sub-repos can run the checks without the central repo. No template variables are substituted. An entry can be an object with from, profiles and optionally repos to go to some profiles or repos only: shared-ai gets the app's tool-token verifier files as a test fixture so shared-ai tests the real verifier (#672).",
    "files": {
      ".standards/check.mjs": "scripts/standards-check.mjs",
      ".standards/lib/manifest.mjs": "scripts/lib/manifest.mjs",
      ".standards/lib/hash.mjs": "scripts/lib/hash.mjs",
      ".standards/lib/render.mjs": "scripts/lib/render.mjs",
      ".standards/lib/env-tags.mjs": "scripts/lib/env-tags.mjs",
      ".standards/ioc-scan.mjs": "scripts/ioc-scan.mjs",
      ".standards/secret-scan.mjs": "scripts/secret-scan.mjs",
      ".standards/license-check.mjs": { "from": "scripts/license-check.mjs", "profiles": ["app"] },
      ".standards/blocked-packages.json": "security/blocked-packages.json",
      ".standards/ci-migrate.sh": { "from": "scripts/ci-migrate.sh", "profiles": ["app"] },
      "backend/test/standard/tools.ts": { "from": "templates/app/backend/src/standard/tools.ts", "profiles": ["service"], "repos": ["sirloinbh/shared-ai"] },
      "backend/test/standard/audit.ts": { "from": "templates/app/backend/src/standard/audit.ts", "profiles": ["service"], "repos": ["sirloinbh/shared-ai"] },
      "backend/test/standard/db.ts": { "from": "templates/app/backend/src/standard/db.ts", "profiles": ["service"], "repos": ["sirloinbh/shared-ai"] }
    }
  },
  "data": { "why": "Data read by the sync script, so it is not copied to target repos as a file. labels.json is applied as the issue labels of the target repo (#40).", "files": ["common/labels.json"] },
  "mirror": [{ "from": "skills/", "to": ".claude/skills/", "why": "Claude Code reads only .claude/skills/. A copy with the same content as the source skills/ is managed too." }],
  "dependencyFields": {
    "why": "The versions.json dependencies (external dependencies shared by the 8 apps and the scaffold) are written into managed fields of the 3 app package.json files. Versions are raised centrally and spread through sync PRs; standards-check catches an app that differs (#304).",
    "profiles": ["app"],
    "files": { "root": "package.json", "frontend": "frontend/package.json", "backend": "backend/package.json" },
    "onlyWith": { "frontend/package.json": { "dependencies.zod": "contract" } }
  },
  "fields": {
    "app": {
      "package.json": { "packageManager": "npm@{{versions.npm}}", "engines": { "node": "{{versions.node}}", "npm": "{{versions.npm}}" }, "scripts": { "standards:check": "node .standards/check.mjs", "knip": "knip" }, "devDependencies": { "@sirloinbh/eslint-config": "{{versions.packages.@sirloinbh/eslint-config}}", "@sirloinbh/prettier-config": "{{versions.packages.@sirloinbh/prettier-config}}" } },
      "frontend/package.json": { "packageManager": "npm@{{versions.npm}}", "engines": { "node": "{{versions.node}}", "npm": "{{versions.npm}}" }, "dependencies": { "@sirloinbh/auth-client": "{{versions.packages.@sirloinbh/auth-client}}", "@sirloinbh/design-tokens": "{{versions.packages.@sirloinbh/design-tokens}}" }, "devDependencies": { "@sirloinbh/tsconfig": "{{versions.packages.@sirloinbh/tsconfig}}" } },
      "backend/package.json": { "packageManager": "npm@{{versions.npm}}", "engines": { "node": "{{versions.node}}", "npm": "{{versions.npm}}" }, "dependencies": { "@sirloinbh/auth-client": "{{versions.packages.@sirloinbh/auth-client}}" }, "devDependencies": { "@sirloinbh/tsconfig": "{{versions.packages.@sirloinbh/tsconfig}}" } }
    },
    "service": {
      "backend/package.json": { "packageManager": "npm@{{versions.npm}}", "engines": { "node": "{{versions.node}}", "npm": "{{versions.npm}}" } }
    }
  }
}
