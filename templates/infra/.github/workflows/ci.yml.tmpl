# Calls the central shared CI (reusable-infra-ci) pinned to the central commit that was synced. It does not run terraform apply.
name: ci

on: [push, pull_request]

permissions:
  contents: read

jobs:
  ci:
    uses: sirloinbh/project-standards/.github/workflows/reusable-infra-ci.yml@{{central.workflowSha}}
    with:
      terraform-version: '{{versions.terraform.cli}}'
      node-version: '{{versions.node}}'
