# Calls the central shared CI (reusable-service-ci) pinned to the central commit that was synced.
name: ci

on: [push, pull_request]

permissions:
  contents: read
  # write is the most the image-push job of the reusable workflow may use; every other job gets read (ADR-0023, #757).
  packages: write

jobs:
  ci:
    uses: sirloinbh/project-standards/.github/workflows/reusable-service-ci.yml@{{central.workflowSha}}
    with:
      node-version: '{{versions.node}}'
      npm-version: '{{versions.npm}}'
      push-images: {{project.deploy.push}}
      image-prefix: 'ghcr.io/sirloinbh/{{project.name}}'
