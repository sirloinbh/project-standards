#!/bin/bash
# Compatibility wrapper (#696): the shared service deploys now use deploy/remote-deploy.sh like the apps.
# An autodeploy.sh copy that started before the update still calls `deploy/deploy.sh --no-pull`, so this
# file stays for one release. It deploys the checked-out commit; the extra argument is ignored.
set -euo pipefail
cd "$(dirname "$0")/.."
exec bash deploy/remote-deploy.sh deploy "$(git rev-parse HEAD)"
