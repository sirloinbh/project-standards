{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "도구 버전 원본",
  "description": "템플릿에 주입하는 도구 버전. 범위 버전(^, ~)은 쓰지 않는다. 외부 Action은 커밋 SHA로 고정한다.",
  "type": "object",
  "required": ["node", "npm", "postgres", "terraform", "images", "runner", "actions", "dependencies", "packages"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "node": { "$ref": "#/$defs/exact" },
    "npm": { "$ref": "#/$defs/exact" },
    "postgres": { "type": "string", "pattern": "^\\d+$", "description": "메이저 버전" },
    "terraform": {
      "type": "object",
      "required": ["required", "cli"],
      "additionalProperties": false,
      "properties": {
        "required": { "type": "string", "minLength": 1, "description": "versions.tf의 required_version" },
        "cli": { "type": ["string", "null"], "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "CI에서 설치할 정확한 버전. 미정이면 null" }
      }
    },
    "images": {
      "type": "object",
      "required": ["node", "nginx", "postgres", "playwright", "devcontainerNode"],
      "additionalProperties": false,
      "properties": {
        "node": { "$ref": "#/$defs/image" },
        "nginx": { "$ref": "#/$defs/image" },
        "postgres": { "$ref": "#/$defs/image" },
        "devcontainerNode": { "$ref": "#/$defs/pinnedImage", "description": "Dev Container(features.devcontainer)의 Node 이미지. git이 있는 bookworm을 쓰고 digest로 고정한다. Node 버전은 node와 같아야 한다(#282)" },
        "playwright": { "$ref": "#/$defs/pinnedImage", "description": "화면 비교(features.e2eVisual)용 Playwright 컨테이너. 태그를 다시 push해도 글꼴·브라우저가 바뀌지 않게 digest로 고정한다. 버전은 앱의 @playwright/test와 같아야 한다" }
      }
    },
    "runner": {
      "type": "string",
      "pattern": "^ubuntu-\\d+\\.\\d+$",
      "description": "워크플로 runs-on에 쓰는 GitHub 호스팅 러너. ubuntu-latest처럼 바뀌는 이름 대신 버전을 고정한다"
    },
    "windowsRunner": {
      "type": "string",
      "pattern": "^windows-\\d{4}$",
      "description": "Windows에서만 확인할 수 있는 검사(로컬 에이전트 워커 등)에 쓰는 고정 러너. 중앙 리포 워크플로에만 쓴다"
    },
    "actions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["repo", "version", "sha"],
        "additionalProperties": false,
        "properties": {
          "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
          "version": { "type": "string", "pattern": "^v\\d+\\.\\d+\\.\\d+$" },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "description": "앱 8개와 스캐폴드가 같은 파일·같은 칸에 같은 버전으로 쓰는 외부 의존성. 앱 package.json 3개(root, frontend, backend)의 관리 필드가 된다(templates/index.json dependencyFields, #304). 이름에 점(.)은 쓸 수 없다",
      "required": ["root", "frontend", "backend"],
      "additionalProperties": false,
      "properties": {
        "root": { "$ref": "#/$defs/dependencySections" },
        "frontend": { "$ref": "#/$defs/dependencySections" },
        "backend": { "$ref": "#/$defs/dependencySections" }
      }
    },
    "packages": {
      "type": "object",
      "description": "A안 패키지의 배포 버전. 아직 배포 전이면 null",
      "additionalProperties": { "type": ["string", "null"], "pattern": "^\\d+\\.\\d+\\.\\d+$" }
    }
  },
  "$defs": {
    "dependencySections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dependencies": { "type": "object", "additionalProperties": { "$ref": "#/$defs/exact" } },
        "devDependencies": { "type": "object", "additionalProperties": { "$ref": "#/$defs/exact" } }
      }
    },
    "exact": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "image": { "type": "string", "pattern": "^[a-z0-9./-]+:[A-Za-z0-9._-]+$" },
    "pinnedImage": { "type": "string", "pattern": "^[a-z0-9./-]+:[A-Za-z0-9._-]+@sha256:[0-9a-f]{64}$" }
  }
}
